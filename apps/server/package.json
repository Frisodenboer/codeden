{
  "name": "@codeden/server",
  "version": "0.0.0",
  "private": true,
  "description": "CodeDen server: Hono HTTP + WebSocket, SQLite event log and projections, runner client.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node --watch --watch-preserve-output --import tsx src/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@codeden/contracts": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/keyring": "^2.1.2",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.17",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codeden/providers": "workspace:*",
    "@codeden/runner": "workspace:*",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "1.0.0-rc.5",
    "tsx": "^4.23.15"
  }
}
