{
  "name": "codeden",
  "version": "0.0.0",
  "description": "A local-first harness for coding agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codeden": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "coding-agents",
    "claude-code",
    "codex",
    "harness",
    "local-first"
  ],
  "scripts": {
    "build": "tsdown && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.17",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codeden/contracts": "workspace:*",
    "@codeden/providers": "workspace:*",
    "@codeden/runner": "workspace:*",
    "@codeden/server": "workspace:*",
    "@codeden/web": "workspace:*",
    "tsdown": "^0.23.7"
  }
}
