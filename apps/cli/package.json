  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/keyring": "^2.1.2",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.17",
    "node-pty": "1.1.0",
    "playwright-core": "1.64.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codeden/contracts": "workspace:*",
    "@codeden/providers": "workspace:*",
    "@codeden/runner": "workspace:*",
    "@codeden/server": "workspace:*",
    "@codeden/web": "workspace:*",
    "tsdown": "^0.23.7"
  }
