{
  "name": "codeden-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev-token.mjs && pnpm --parallel --filter @codeden/server --filter @codeden/web run dev",
    "build": "pnpm -r --filter=!codeden-monorepo run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @codeden/server run db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
